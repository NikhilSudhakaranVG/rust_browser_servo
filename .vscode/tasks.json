{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install & Run on Device",
            "type": "shell",
            "command": "cmd /c \".\\gradlew installDebug && adb -d shell am start -n de.baumann.browser/de.baumann.browser.feature.browser.BrowserActivity\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Assemble Debug APK",
            "type": "shell",
            "command": ".\\gradlew assembleDebug",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Launch App on Device",
            "type": "shell",
            "command": "adb -d shell am start -n de.baumann.browser/de.baumann.browser.feature.browser.BrowserActivity",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "View Device Logcat",
            "type": "shell",
            "command": "adb -d logcat -s browser:V AndroidRuntime:E",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}
