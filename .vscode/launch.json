{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run on Physical Device (F5)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/run.js",
            "preLaunchTask": "Install & Run on Device",
            "console": "internalConsole"
        },
        {
            "name": "Debug App on Physical Device (Android)",
            "type": "android",
            "request": "launch",
            "targetDevice": "R9ZX205NJAK",
            "launchActivity": "de.baumann.browser.feature.browser.BrowserActivity",
            "appSrcRoot": "${workspaceFolder}/app/src/main",
            "apkFile": "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk",
            "preLaunchTask": "Assemble Debug APK"
        },
        {
            "name": "Attach Debugger to Running App (Android)",
            "type": "android",
            "request": "attach",
            "targetDevice": "R9ZX205NJAK",
            "processId": "de.baumann.browser"
        }
    ]
}